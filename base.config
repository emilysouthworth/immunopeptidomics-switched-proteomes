/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/mhcquant Nextflow base config file and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    cpus   = { 1      * task.attempt }
    memory = { 24.GB   * task.attempt }
    time   = { 10.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 24.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:process_high_mem_high_cpu {
        cpus   = { 24    * task.attempt }
        memory = { 6.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withName:NFCORE_MHCQUANT:MHCQUANT:PREPARE_SPECTRA:TDF2MZML {
        cpus   = { 1     * task.attempt, 'cpus'   }
        memory = { 20.GB * task.attempt, 'memory' }
        time   = { 16.h  * task.attempt, 'time'   }
    }

   beforeScript   = '''
    . /etc/profile.d/modules.sh
    module load igmm/apps/singularity/3.8.7 
    export SINGULARITY_TMPDIR="$TMPDIR"
    '''

}


env {
    MALLOC_ARENA_MAX = 1
    //TMPDIR = "/exports/eddie/scratch/esouthwo/tmp"
    //SINGULARITY_TMPDIR = "/exports/eddie/scratch/esouthwo/tmp"
    //SINGULARITY_CACHEDIR = "/exports/eddie/scratch/esouthwo/singularity-cache"
}


singularity {
    envWhitelist = "SINGULARITY_TMPDIR,TMPDIR"
    runOptions   = '-p --scratch /dev/shm -B "$TMPDIR"'
    enabled      = true
    autoMounts   = true
    cacheDir     = "/exports/eddie/scratch/esouthwo/singularity-images"
    pullTimeout  = '60m'
}
   
